#ifndef __ZGOLD_DEBUG_PANEL_MQH__
#define __ZGOLD_DEBUG_PANEL_MQH__
#define ZGOLD_PANEL_PREFIX "ZGOLD_DEBUG_"
#define ZGOLD_PANEL_PENDING_LINES 6
#define ZGOLD_PANEL_LIFECYCLE_LINES 5
class DebugPanel
{
private:
 long m_tick_count; string m_runtime_state; string m_last_event; string m_error; bool m_core,m_market,m_reconciler,m_trailing,m_state;
 string m_operational_state,m_state_reason,m_decision,m_action;
 int m_buy_count,m_sell_count; double m_buy_lots,m_sell_lots,m_buy_profit,m_sell_profit,m_total_profit;
 int m_pending_count; int m_pending_ticket[ZGOLD_PANEL_PENDING_LINES]; int m_pending_type[ZGOLD_PANEL_PENDING_LINES]; double m_pending_lots[ZGOLD_PANEL_PENDING_LINES]; double m_pending_price[ZGOLD_PANEL_PENDING_LINES];
 string m_transition; int m_life_ticket,m_life_prev_type,m_life_cur_type; double m_life_prev_lots,m_life_cur_lots,m_life_prev_price,m_life_cur_price;
 string m_life_history[ZGOLD_PANEL_LIFECYCLE_LINES]; int m_life_history_count;
 int m_trail_count; int m_trail_ticket[ZGOLD_PANEL_PENDING_LINES]; int m_trail_type[ZGOLD_PANEL_PENDING_LINES]; double m_trail_delta[ZGOLD_PANEL_PENDING_LINES]; string m_trail_class[ZGOLD_PANEL_PENDING_LINES]; bool m_trail_valid[ZGOLD_PANEL_PENDING_LINES];
 void Label(string id,int x,int y,string text,int size=9){string n=ZGOLD_PANEL_PREFIX+id;if(ObjectFind(0,n)<0){ObjectCreate(0,n,OBJ_LABEL,0,0,0);ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);ObjectSetInteger(0,n,OBJPROP_FONTSIZE,size);ObjectSetString(0,n,OBJPROP_FONT,"Consolas");ObjectSetInteger(0,n,OBJPROP_COLOR,clrWhite);ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);}ObjectSetString(0,n,OBJPROP_TEXT,text);}
 void Background(){string n=ZGOLD_PANEL_PREFIX+"BACKGROUND";if(ObjectFind(0,n)<0){ObjectCreate(0,n,OBJ_RECTANGLE_LABEL,0,0,0);ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);ObjectSetInteger(0,n,OBJPROP_XDISTANCE,10);ObjectSetInteger(0,n,OBJPROP_YDISTANCE,10);ObjectSetInteger(0,n,OBJPROP_XSIZE,620);ObjectSetInteger(0,n,OBJPROP_YSIZE,570);ObjectSetInteger(0,n,OBJPROP_BGCOLOR,clrBlack);ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,clrDimGray);ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);}}
 string TypeName(int t){if(t==OP_BUY)return "BUY";if(t==OP_SELL)return "SELL";if(t==OP_BUYSTOP)return "BUY STOP";if(t==OP_SELLSTOP)return "SELL STOP";if(t==OP_BUYLIMIT)return "BUY LIMIT";if(t==OP_SELLLIMIT)return "SELL LIMIT";return "-";}
 void PushLifecycle(string text){if(text==""||text=="NO CHANGE")return;for(int i=ZGOLD_PANEL_LIFECYCLE_LINES-1;i>0;i--)m_life_history[i]=m_life_history[i-1];m_life_history[0]=text;if(m_life_history_count<ZGOLD_PANEL_LIFECYCLE_LINES)m_life_history_count++;}
public:
 DebugPanel(){m_tick_count=0;m_runtime_state="RESET";m_last_event="WAITING";m_error="";m_core=false;m_market=false;m_reconciler=false;m_trailing=false;m_state=false;m_operational_state="RESET";m_state_reason="NO STATE";m_decision="NOT IMPLEMENTED";m_action="NONE";m_buy_count=0;m_sell_count=0;m_buy_lots=0;m_sell_lots=0;m_buy_profit=0;m_sell_profit=0;m_total_profit=0;m_pending_count=0;m_transition="NO CHANGE";m_life_ticket=-1;m_life_prev_type=-1;m_life_cur_type=-1;m_life_prev_lots=0;m_life_cur_lots=0;m_life_prev_price=0;m_life_cur_price=0;m_life_history_count=0;m_trail_count=0;for(int i=0;i<ZGOLD_PANEL_PENDING_LINES;i++){m_pending_ticket[i]=-1;m_pending_type[i]=0;m_pending_lots[i]=0;m_pending_price[i]=0;m_trail_ticket[i]=-1;m_trail_type[i]=-1;m_trail_delta[i]=0;m_trail_class[i]="UNRESOLVED";m_trail_valid[i]=false;}for(int j=0;j<ZGOLD_PANEL_LIFECYCLE_LINES;j++)m_life_history[j]="";}
 void Initialize(){Background();Render();} void IncrementTick(){m_tick_count++;}
 void SetModuleStatus(string m,bool s){if(m=="CORE")m_core=s;else if(m=="MARKET STATE")m_market=s;else if(m=="STATE RECONCILER")m_reconciler=s;else if(m=="PENDING TRAILING")m_trailing=s;else if(m=="OPERATIONAL STATE")m_state=s;} void SetRuntimeState(string s){m_runtime_state=s;} void SetLastEvent(string s){m_last_event=s;} void SetError(string s){m_error=s;}
 void SetOperationalState(string state,string reason){m_operational_state=state;m_state_reason=reason;} void SetDecisionAction(string decision,string action){m_decision=decision;m_action=action;}
 void SetMarket(double b,double a,double sp,datetime t){Label("BID",25,120,"Bid       : "+DoubleToString(b,Digits));Label("ASK",25,135,"Ask       : "+DoubleToString(a,Digits));Label("SPREAD",25,150,"Spread    : "+DoubleToString(sp,1)+" points");Label("TIME",25,165,"Server    : "+TimeToString(t,TIME_DATE|TIME_SECONDS));}
 void SetExposure(int bc,double bl,double bp,int sc,double sl,double sp,double tp){m_buy_count=bc;m_buy_lots=bl;m_buy_profit=bp;m_sell_count=sc;m_sell_lots=sl;m_sell_profit=sp;m_total_profit=tp;}
 void SetPending(PendingState &p){m_pending_count=p.Count();for(int i=0;i<ZGOLD_PANEL_PENDING_LINES;i++){m_pending_ticket[i]=-1;m_pending_type[i]=0;m_pending_lots[i]=0;m_pending_price[i]=0;if(i<m_pending_count){m_pending_ticket[i]=p.Ticket(i);m_pending_type[i]=p.Type(i);m_pending_lots[i]=p.Lots(i);m_pending_price[i]=p.Price(i);}}}
 void SetLifecycle(int ev,int ticket,int prev_type,int cur_type,double prev_lots,double cur_lots,double prev_price,double cur_price,string text){m_transition=text;m_life_ticket=ticket;m_life_prev_type=prev_type;m_life_cur_type=cur_type;m_life_prev_lots=prev_lots;m_life_cur_lots=cur_lots;m_life_prev_price=prev_price;m_life_cur_price=cur_price;if(text!="NO CHANGE"&&text!="INITIAL SNAPSHOT")PushLifecycle(text);}
 void SetTrailingInventory(int count,int &tickets[],int &types[],double &deltas[],string &classes[],bool &valids[]){m_trail_count=count;if(m_trail_count>ZGOLD_PANEL_PENDING_LINES)m_trail_count=ZGOLD_PANEL_PENDING_LINES;for(int i=0;i<ZGOLD_PANEL_PENDING_LINES;i++){m_trail_ticket[i]=-1;m_trail_type[i]=-1;m_trail_delta[i]=0;m_trail_class[i]="-";m_trail_valid[i]=false;if(i<m_trail_count){m_trail_ticket[i]=tickets[i];m_trail_type[i]=types[i];m_trail_delta[i]=deltas[i];m_trail_class[i]=classes[i];m_trail_valid[i]=valids[i];}}}
 void Render(){Background();int x=25;Label("TITLE",x,18,"ZGOLD - DEBUG PANEL",11);Label("SYSTEM",x,45,"SYSTEM",9);Label("STATUS",x,60,"EA        : "+m_runtime_state);Label("SYMBOL",x,75,"SYMBOL    : "+Symbol());Label("MARKET",x,105,"MARKET",9);Label("RUNTIME",x,190,"RUNTIME",9);Label("TICK",x,205,"Tick      : "+IntegerToString((int)m_tick_count));Label("EXPOSURE",x,230,"EXPOSURE",9);Label("BUY",x,245,"BUY       : "+IntegerToString(m_buy_count)+" | "+DoubleToString(m_buy_lots,2)+" | "+DoubleToString(m_buy_profit,2));Label("SELL",x,260,"SELL      : "+IntegerToString(m_sell_count)+" | "+DoubleToString(m_sell_lots,2)+" | "+DoubleToString(m_sell_profit,2));Label("TOTAL",x,275,"TOTAL P/L : "+DoubleToString(m_total_profit,2));Label("PENDING",x,300,"PENDING : "+IntegerToString(m_pending_count),9);for(int i=0;i<ZGOLD_PANEL_PENDING_LINES;i++){string id="P"+IntegerToString(i);string tx="";if(i<m_pending_count)tx=TypeName(m_pending_type[i])+" #"+IntegerToString(m_pending_ticket[i])+" | "+DoubleToString(m_pending_lots[i],2)+" | "+DoubleToString(m_pending_price[i],Digits);Label(id,x,315+i*15,tx);}
 Label("MODULES",330,45,"MODULES",9);Label("CORE",330,60,"Core            ["+(m_core?"OK":"WAIT")+"]");Label("MARKET_MODULE",330,75,"MarketState     ["+(m_market?"OK":"WAIT")+"]");Label("RECONCILER",330,90,"Reconciler      ["+(m_reconciler?"OK":"WAIT")+"]");Label("TRAIL_MODULE",330,105,"PendingTrailing ["+(m_trailing?"OK":"WAIT")+"]");Label("STATE_MODULE",330,120,"OperationalState ["+(m_state?"OK":"WAIT")+"]");Label("STATE",330,140,"STATE      : "+m_operational_state);Label("STATE_REASON",330,155,"Reason     : "+m_state_reason);Label("DECISION",330,170,"DECISION    : "+m_decision);Label("ACTION",330,185,"ACTION      : "+m_action);Label("EVENT",330,205,"LAST EVENT",9);Label("LAST_EVENT",330,220,"> "+m_last_event);Label("LIFECYCLE",330,245,"LIFECYCLE TRACE",9);Label("LIFE_TRANS",330,260,"Last       : "+m_transition);Label("LIFE_TICKET",330,275,"Ticket     : #"+IntegerToString(m_life_ticket));Label("LIFE_PREV",330,290,"Previous   : "+TypeName(m_life_prev_type)+" | "+DoubleToString(m_life_prev_lots,2)+" | "+DoubleToString(m_life_prev_price,Digits));Label("LIFE_CUR",330,305,"Current    : "+TypeName(m_life_cur_type)+" | "+DoubleToString(m_life_cur_lots,2)+" | "+DoubleToString(m_life_cur_price,Digits));for(int h=0;h<ZGOLD_PANEL_LIFECYCLE_LINES;h++)Label("LH"+IntegerToString(h),330,320+h*12,(h<m_life_history_count?"  "+m_life_history[h]:""),8);Label("TRAIL",330,390,"TRAILING OBSERVER ["+IntegerToString(m_trail_count)+"]",9);for(int j=0;j<ZGOLD_PANEL_PENDING_LINES;j++){string tid="TRAIL_"+IntegerToString(j);string tt="";if(j<m_trail_count)tt="#"+IntegerToString(m_trail_ticket[j])+" "+TypeName(m_trail_type[j])+" | d="+DoubleToString(m_trail_delta[j],2)+" | "+m_trail_class[j]+" | "+(m_trail_valid[j]?"OK":"NO");Label(tid,330,405+j*14,tt);}if(m_error!="")Label("ERROR",330,500,"> ERROR: "+m_error);}
 void Destroy(){for(int i=ObjectsTotal()-1;i>=0;i--){string n=ObjectName(i);if(StringFind(n,ZGOLD_PANEL_PREFIX,0)==0)ObjectDelete(0,n);}}
};
#endif
